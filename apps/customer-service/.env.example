# Local-development env template for customer-service.
# Copy to .env (gitignored) and fill in any non-default values.
# Profile-driven: SPRING_PROFILES_ACTIVE selects which application-{profile}.yml
# to activate (dev|stg|prod). See docs/architecture/CONFIGURATION_ARCHITECTURE.md.

SPRING_PROFILES_ACTIVE=dev

# ----- Database -----
# Single shared DB `trips_enjoy`; this service owns schema `customer` (Flyway creates it on boot).
CUSTOMER_SERVICE_DB_URL=jdbc:postgresql://0.0.0.0:5432/trips_enjoy?currentSchema=customer
CUSTOMER_SERVICE_DB_USERNAME=postgres
CUSTOMER_SERVICE_DB_PASSWORD=

# ----- Redis -----
CUSTOMER_SERVICE_REDIS_HOST=0.0.0.0
CUSTOMER_SERVICE_REDIS_PORT=6379
CUSTOMER_SERVICE_REDIS_PASSWORD=

# ----- Kafka -----
# Platform Kafka cluster (inherited). Override per-env via Vault at deploy time.
CUSTOMER_SERVICE_KAFKA_BOOTSTRAP_SERVERS=http://81.208.166.110:9092

# ----- Keycloak -----
# Platform Keycloak (inherited). All values are placeholders; real values come
# from a per-service .env (gitignored) in local dev, or Vault in stg/prod.
CUSTOMER_SERVICE_KEYCLOAK_BASE_URL=http://0.0.0.0:8181
CUSTOMER_SERVICE_KEYCLOAK_ISSUER_URI=http://0.0.0.0:8181/realms/platform-services
CUSTOMER_SERVICE_KEYCLOAK_JWKS_URI=http://0.0.0.0:8181/realms/platform-services/protocol/openid-connect/certs
CUSTOMER_SERVICE_KEYCLOAK_ADMIN_REALM=master
CUSTOMER_SERVICE_KEYCLOAK_ADMIN_CLIENT_ID=
CUSTOMER_SERVICE_KEYCLOAK_ADMIN_CLIENT_SECRET=
CUSTOMER_SERVICE_KEYCLOAK_ADMIN_USERNAME=
CUSTOMER_SERVICE_KEYCLOAK_ADMIN_PASSWORD=
