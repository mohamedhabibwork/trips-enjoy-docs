# Local-development env template for restaurant-service.
# Copy to .env (gitignored) and fill in any non-default values.
# Profile-driven: SPRING_PROFILES_ACTIVE selects which application-{profile}.yml
# to activate (dev|stg|prod). See docs/architecture/CONFIGURATION_ARCHITECTURE.md.

SPRING_PROFILES_ACTIVE=dev

# ----- Database -----
# Single shared DB `trips_enjoy`; this service owns schema `restaurant` (Flyway creates it on boot).
RESTAURANT_SERVICE_DB_URL=jdbc:postgresql://0.0.0.0:5432/trips_enjoy?currentSchema=restaurant
RESTAURANT_SERVICE_DB_USERNAME=postgres
RESTAURANT_SERVICE_DB_PASSWORD=

# ----- Redis -----
RESTAURANT_SERVICE_REDIS_HOST=0.0.0.0
RESTAURANT_SERVICE_REDIS_PORT=6379
RESTAURANT_SERVICE_REDIS_PASSWORD=

# ----- Kafka -----
# Platform Kafka cluster (inherited). Override per-env via Vault at deploy time.
RESTAURANT_SERVICE_KAFKA_BOOTSTRAP_SERVERS=http://81.208.166.110:9092

# ----- Keycloak -----
# Platform Keycloak (inherited). All values are placeholders; real values come
# from a per-service .env (gitignored) in local dev, or Vault in stg/prod.
RESTAURANT_SERVICE_KEYCLOAK_BASE_URL=http://0.0.0.0:8181
RESTAURANT_SERVICE_KEYCLOAK_ISSUER_URI=http://0.0.0.0:8181/realms/platform-services
RESTAURANT_SERVICE_KEYCLOAK_JWKS_URI=http://0.0.0.0:8181/realms/platform-services/protocol/openid-connect/certs
RESTAURANT_SERVICE_KEYCLOAK_ADMIN_REALM=master
RESTAURANT_SERVICE_KEYCLOAK_ADMIN_CLIENT_ID=
RESTAURANT_SERVICE_KEYCLOAK_ADMIN_CLIENT_SECRET=
RESTAURANT_SERVICE_KEYCLOAK_ADMIN_USERNAME=
RESTAURANT_SERVICE_KEYCLOAK_ADMIN_PASSWORD=
