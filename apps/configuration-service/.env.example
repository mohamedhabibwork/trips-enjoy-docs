# Local-development env template for configuration-service.
# Copy to .env (gitignored) and fill in any non-default values.
# Profile-driven: SPRING_PROFILES_ACTIVE selects which application-{profile}.yml
# to activate (dev|stg|prod). See docs/architecture/CONFIGURATION_ARCHITECTURE.md.

SPRING_PROFILES_ACTIVE=dev

# ----- Database -----
# Single shared DB `trips_enjoy`; this service owns schema `configuration` (Flyway creates it on boot).
CONFIGURATION_SERVICE_DB_URL=jdbc:postgresql://0.0.0.0:5432/trips_enjoy?currentSchema=configuration
CONFIGURATION_SERVICE_DB_USERNAME=postgres
CONFIGURATION_SERVICE_DB_PASSWORD=

# ----- Redis -----
CONFIGURATION_SERVICE_REDIS_HOST=0.0.0.0
CONFIGURATION_SERVICE_REDIS_PORT=6379
CONFIGURATION_SERVICE_REDIS_PASSWORD=

# ----- Kafka -----
# Platform Kafka cluster (inherited). Override per-env via Vault at deploy time.
CONFIGURATION_SERVICE_KAFKA_BOOTSTRAP_SERVERS=http://81.208.166.110:9092

# ----- Keycloak -----
# Platform Keycloak (inherited). All values are placeholders; real values come
# from a per-service .env (gitignored) in local dev, or Vault in stg/prod.
CONFIGURATION_SERVICE_KEYCLOAK_BASE_URL=http://0.0.0.0:8181
CONFIGURATION_SERVICE_KEYCLOAK_ISSUER_URI=http://0.0.0.0:8181/realms/platform-services
CONFIGURATION_SERVICE_KEYCLOAK_JWKS_URI=http://0.0.0.0:8181/realms/platform-services/protocol/openid-connect/certs
CONFIGURATION_SERVICE_KEYCLOAK_ADMIN_REALM=master
CONFIGURATION_SERVICE_KEYCLOAK_ADMIN_CLIENT_ID=
CONFIGURATION_SERVICE_KEYCLOAK_ADMIN_CLIENT_SECRET=
CONFIGURATION_SERVICE_KEYCLOAK_ADMIN_USERNAME=
CONFIGURATION_SERVICE_KEYCLOAK_ADMIN_PASSWORD=

# ----- Service tuning (optional, defaults shown) -----
# Outbox poller cadence for configuration.updated.v1 / .rolled_back.v1 / etc.
CONFIGURATION_SERVICE_OUTBOX_PUBLISH_INTERVAL_MS=1000
# Redis read-cache TTL (FR-020).
CONFIGURATION_SERVICE_READ_CACHE_TTL_SECONDS=300
# Long-poll max wait + concurrency cap (NFR-004).
CONFIGURATION_SERVICE_LONGPOLL_MAX_WAIT_SECONDS=25
CONFIGURATION_SERVICE_LONGPOLL_MAX_CONNS_PER_POD=1000
# Daily snapshot job (FR-015, configuration.snapshot.exported.v1).
CONFIGURATION_SERVICE_SNAPSHOT_CRON=0 0 3 * * *
CONFIGURATION_SERVICE_SNAPSHOT_S3_BUCKET=trips-enjoy-platform-audit
CONFIGURATION_SERVICE_SNAPSHOT_LOCAL_DIR=/tmp/configuration-snapshots
# Monthly partition pre-creation job.
CONFIGURATION_SERVICE_PARTITION_CRON=0 0 2 * * *
CONFIGURATION_SERVICE_PARTITION_PRECREATE_MONTHS=12
# Idempotency-Key TTL (SRS §15).
CONFIGURATION_SERVICE_IDEMPOTENCY_TTL_SECONDS=86400
# Kafka consumer group-id.
CONFIGURATION_SERVICE_KAFKA_CONSUMER_GROUP_ID=configuration-service
