# Local-development env template for audit-service.
# Copy to .env (gitignored) and fill in any non-default values.
# Profile-driven: SPRING_PROFILES_ACTIVE selects which application-{profile}.yml
# to activate (dev|stg|prod). See docs/architecture/CONFIGURATION_ARCHITECTURE.md.

SPRING_PROFILES_ACTIVE=dev

# ----- Database -----
# Single shared DB `trips_enjoy`; this service owns schema `audit` (Flyway creates it on boot).
AUDIT_SERVICE_DB_URL=jdbc:postgresql://0.0.0.0:5432/trips_enjoy?currentSchema=audit
AUDIT_SERVICE_DB_USERNAME=postgres
AUDIT_SERVICE_DB_PASSWORD=

# ----- Redis -----
AUDIT_SERVICE_REDIS_HOST=0.0.0.0
AUDIT_SERVICE_REDIS_PORT=6379
AUDIT_SERVICE_REDIS_PASSWORD=

# ----- Kafka -----
# Platform Kafka cluster (inherited). Override per-env via Vault at deploy time.
AUDIT_SERVICE_KAFKA_BOOTSTRAP_SERVERS=http://81.208.166.110:9092

# ----- Keycloak -----
# Platform Keycloak (inherited). All values are placeholders; real values come
# from a per-service .env (gitignored) in local dev, or Vault in stg/prod.
AUDIT_SERVICE_KEYCLOAK_BASE_URL=http://0.0.0.0:8181
AUDIT_SERVICE_KEYCLOAK_ISSUER_URI=http://0.0.0.0:8181/realms/platform-services
AUDIT_SERVICE_KEYCLOAK_JWKS_URI=http://0.0.0.0:8181/realms/platform-services/protocol/openid-connect/certs
AUDIT_SERVICE_KEYCLOAK_ADMIN_REALM=master
AUDIT_SERVICE_KEYCLOAK_ADMIN_CLIENT_ID=
AUDIT_SERVICE_KEYCLOAK_ADMIN_CLIENT_SECRET=
AUDIT_SERVICE_KEYCLOAK_ADMIN_USERNAME=
AUDIT_SERVICE_KEYCLOAK_ADMIN_PASSWORD=

# ----- Retention / Export / Hash chain (overridable per env) -----
# Retention windows — financial events get 7-year retention, default 1 year.
AUDIT_RETENTION_FINANCIAL_YEARS=7
AUDIT_RETENTION_DEFAULT_YEARS=1
# Hash algorithm for the audit hash chain. Must be one of: sha256, sha384, sha512.
AUDIT_HASH_ALGO=sha256
# Daily export cron (default 04:00 UTC). Daily purge is hardcoded to 05:00 UTC.
AUDIT_EXPORT_CRON=0 0 4 * * *
# S3 bucket + local fallback for the nightly export (real buckets via Vault).
AUDIT_EXPORT_S3_BUCKET=trips-enjoy-platform-audit
AUDIT_EXPORT_S3_PATH_TEMPLATE=s3://trips-enjoy-platform-audit/audit/exports/<yyyy>/<mm>/<dd>/
AUDIT_EXPORT_LOCAL_DIR=/tmp/audit-exports
# Monthly partition pre-create window + cron (default 02:00 UTC).
AUDIT_PARTITION_PRECREATE_MONTHS=12
AUDIT_PARTITION_CRON=0 0 2 * * *
# Kafka consumer settings.
AUDIT_CONSUMER_GROUP_ID=audit-service
AUDIT_LAG_EMIT_INTERVAL_MS=60000
# Outbox publisher tick.
AUDIT_OUTBOX_PUBLISH_INTERVAL_MS=1000
