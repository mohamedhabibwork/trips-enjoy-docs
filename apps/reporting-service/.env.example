# Local-development env template for reporting-service.
# Copy to .env (gitignored) and fill in any non-default values.
#
# Database: single shared `trips_enjoy`; reporting-service owns schema `reporting`.
# Pattern follows apps/<svc>/.env.example conventions from the
# 2026-08-14 scaffold delivery — see project memory
# `uber-apps-scaffold-datasource-state-2026-08-14` for canonical names.

PLATFORM_ENV=dev

# ----- Database (used by both the runtime pool + alembic) -----
REPORTING_SERVICE_DB_URL=postgresql+asyncpg://postgres@0.0.0.0:5432/trips_enjoy?options=-c%20search_path%3Dreporting,public
REPORTING_SERVICE_DB_SYNC_URL=postgresql+psycopg2://postgres@0.0.0.0:5432/trips_enjoy?options=-c%20search_path%3Dreporting,public

REPORTING_SERVICE_DB_USERNAME=postgres
REPORTING_SERVICE_DB_PASSWORD=

# ----- Redis -----
REPORTING_SERVICE_REDIS_URL=redis://0.0.0.0:6379

# ----- Kafka (platform cluster) -----
REPORTING_SERVICE_KAFKA_BOOTSTRAP_SERVERS=http://81.208.166.110:9092
REPORTING_SERVICE_KAFKA_CONSUMER_GROUP=reporting-service
REPORTING_SERVICE_KAFKA_DLQ_SUFFIX=.dlq

# ----- Keycloak (shared; this service validates JWTs only) -----
REPORTING_SERVICE_KEYCLOAK_BASE_URL=http://0.0.0.0:8181
REPORTING_SERVICE_KEYCLOAK_ISSUER_URI=http://0.0.0.0:8181/realms/platform-services
REPORTING_SERVICE_KEYCLOAK_JWKS_URI=http://0.0.0.0:8181/realms/platform-services/protocol/openid-connect/certs
REPORTING_SERVICE_KEYCLOAK_ADMIN_REALM=master
REPORTING_SERVICE_KEYCLOAK_ADMIN_CLIENT_ID=
REPORTING_SERVICE_KEYCLOAK_ADMIN_CLIENT_SECRET=
REPORTING_SERVICE_KEYCLOAK_ADMIN_USERNAME=
REPORTING_SERVICE_KEYCLOAK_ADMIN_PASSWORD=

# ----- Auth mode (local dev / tests) -----
# When `true` the service trusts the bearer as a UUID without verifying
# the JWT signature. Set to `false` in stg / prod to require JWKS checks.
REPORTING_SERVICE_AUTH_STUB_MODE=true
REPORTING_SERVICE_AUTH_SOFT_MODE=true

# ----- S3 (export target) -----
REPORTING_SERVICE_S3_BUCKET=trips-enjoy-platform-reporting
REPORTING_SERVICE_S3_REGION=us-east-1
REPORTING_SERVICE_S3_ENDPOINT_URL=

# ----- HTTP -----
PORT=8103

# ----- Background workers (dev opt-in) -----
REPORTING_SERVICE_RUN_CONSUMER=false
REPORTING_SERVICE_RUN_OUTBOX=false

# ----- Secrets (Vault path convention) -----
#   kv/<env>/reporting/db/url
# See docs/architecture/SECURITY_ARCHITECTURE.md §Secrets.