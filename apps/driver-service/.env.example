# Local-development env template for driver-service.
# Copy to .env (gitignored) and fill in any non-default values.
# Profile-driven: SPRING_PROFILES_ACTIVE selects which application-{profile}.yml
# to activate (dev|stg|prod). See docs/architecture/CONFIGURATION_ARCHITECTURE.md.

SPRING_PROFILES_ACTIVE=dev

# ----- Database -----
# Single shared DB `trips_enjoy`; this service owns schema `driver` (Flyway creates it on boot).
DRIVER_SERVICE_DB_URL=jdbc:postgresql://0.0.0.0:5432/trips_enjoy?currentSchema=driver
DRIVER_SERVICE_DB_USERNAME=postgres
DRIVER_SERVICE_DB_PASSWORD=

# ----- Redis -----
DRIVER_SERVICE_REDIS_HOST=0.0.0.0
DRIVER_SERVICE_REDIS_PORT=6379
DRIVER_SERVICE_REDIS_PASSWORD=

# ----- Kafka -----
# Platform Kafka cluster (inherited). Override per-env via Vault at deploy time.
DRIVER_SERVICE_KAFKA_BOOTSTRAP_SERVERS=http://81.208.166.110:9092

# ----- Keycloak -----
# Platform Keycloak (inherited). All values are placeholders; real values come
# from a per-service .env (gitignored) in local dev, or Vault in stg/prod.
DRIVER_SERVICE_KEYCLOAK_BASE_URL=http://0.0.0.0:8181
DRIVER_SERVICE_KEYCLOAK_ISSUER_URI=http://0.0.0.0:8181/realms/platform-services
DRIVER_SERVICE_KEYCLOAK_JWKS_URI=http://0.0.0.0:8181/realms/platform-services/protocol/openid-connect/certs
DRIVER_SERVICE_KEYCLOAK_ADMIN_REALM=master
DRIVER_SERVICE_KEYCLOAK_ADMIN_CLIENT_ID=
DRIVER_SERVICE_KEYCLOAK_ADMIN_CLIENT_SECRET=
DRIVER_SERVICE_KEYCLOAK_ADMIN_USERNAME=
DRIVER_SERVICE_KEYCLOAK_ADMIN_PASSWORD=
