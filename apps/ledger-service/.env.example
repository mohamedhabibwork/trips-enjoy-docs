# Local-development env template for ledger-service.
# Copy to .env (gitignored) and fill in any non-default values.
# Profile-driven: SPRING_PROFILES_ACTIVE selects which application-{profile}.yml
# to activate (dev|stg|prod). See docs/architecture/CONFIGURATION_ARCHITECTURE.md.

SPRING_PROFILES_ACTIVE=dev

# ----- Database -----
# Single shared DB `trips_enjoy`; this service owns schema `ledger` (Flyway creates it on boot).
LEDGER_SERVICE_DB_URL=jdbc:postgresql://0.0.0.0:5432/trips_enjoy?currentSchema=ledger
LEDGER_SERVICE_DB_USERNAME=postgres
LEDGER_SERVICE_DB_PASSWORD=

# ----- Redis -----
LEDGER_SERVICE_REDIS_HOST=0.0.0.0
LEDGER_SERVICE_REDIS_PORT=6379
LEDGER_SERVICE_REDIS_PASSWORD=

# ----- Kafka -----
# Platform Kafka cluster (inherited). Override per-env via Vault at deploy time.
LEDGER_SERVICE_KAFKA_BOOTSTRAP_SERVERS=http://81.208.166.110:9092

# ----- Keycloak -----
# Platform Keycloak (inherited). All values are placeholders; real values come
# from a per-service .env (gitignored) in local dev, or Vault in stg/prod.
LEDGER_SERVICE_KEYCLOAK_BASE_URL=http://0.0.0.0:8181
LEDGER_SERVICE_KEYCLOAK_ISSUER_URI=http://0.0.0.0:8181/realms/platform-services
LEDGER_SERVICE_KEYCLOAK_JWKS_URI=http://0.0.0.0:8181/realms/platform-services/protocol/openid-connect/certs
LEDGER_SERVICE_KEYCLOAK_ADMIN_REALM=master
LEDGER_SERVICE_KEYCLOAK_ADMIN_CLIENT_ID=
LEDGER_SERVICE_KEYCLOAK_ADMIN_CLIENT_SECRET=
LEDGER_SERVICE_KEYCLOAK_ADMIN_USERNAME=
LEDGER_SERVICE_KEYCLOAK_ADMIN_PASSWORD=

# ----- ledger-service knobs -----
LEDGER_OUTBOX_PUBLISH_INTERVAL_MS=1000
LEDGER_RETENTION_YEARS=10
LEDGER_PARTITION_PRECREATE_MONTHS=12
LEDGER_PARTITION_CRON=0 0 2 * * *
LEDGER_RECONCILIATION_CRON=0 0 4 * * *
LEDGER_INBOX_CRON=0 30 5 * * *
LEDGER_CONSUMER_GROUP_ID=ledger-service
