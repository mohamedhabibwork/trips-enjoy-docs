  "description": "ledger-service operational dashboard. Recording-rule-driven panels (per monitoring/ledger-service-servicemonitor.yaml). See docs/services/ledger-service/SRS §22 for the metric inventory and monitoring/ledger-service-slo.md for the SLO inventory.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "Runbook", "url": "https://runbooks.trips-enjoy.com/ledger-service", "type": "link", "asDropdown": false, "includeVars": false, "keepTime": false, "tags": [], "targetBlank": true },
    { "title": "SLO doc", "url": "https://docs.trips-enjoy.com/services/ledger-service/observability/slo", "type": "link", "asDropdown": false, "includeVars": false, "keepTime": false, "tags": [], "targetBlank": true }
  ],
  "liveNow": false,
  "panels": [
    {
      "id": 100,
      "title": "SLO burn rate (last 1h / 6h)",
      "description": "Multi-window burn-rate alert reference. >2x budget burn is unhealthy.",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.02 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "1 - ((1 - ledger:error_ratio_5m) ^ (3600 / 1500))", "legendFormat": "1h burn", "refId": "A" },
        { "expr": "1 - ((1 - ledger:error_ratio_5m) ^ (6 * 3600 / 1500))", "legendFormat": "6h burn", "refId": "B" },
        { "expr": "vector(0.001)", "legendFormat": "1x budget", "refId": "C" }
      ]
    },
    {
      "id": 1,
      "title": "Postings rate by account type",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line", "fillOpacity": 30, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" },
          "unit": "ops"
        }
      },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "sum(rate(ledger_postings_total{service=\"ledger-service\"}[1m])) by (account_type, currency)", "legendFormat": "{{ account_type }} ({{ currency }})", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Posting latency (SLO: p99 ≤ 100ms)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.08 },
              { "color": "red", "value": 0.1 }
            ]
          }
        }
      },
      "options": { "legend": { "calcs": ["max"], "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "ledger:posting_p50_seconds", "legendFormat": "p50", "refId": "A" },
        { "expr": "ledger:posting_p95_seconds", "legendFormat": "p95", "refId": "B" },
        { "expr": "ledger:posting_p99_seconds", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "id": 3,
      "title": "Outbox publish lag (alert > 5s)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 60 }
            ]
          },
          "unit": "s"
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "ledger:outbox_lag_seconds_max", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Reconciliation drift (24h) — must be 0",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "none"
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "ledger:reconciliation_drift_count_24h", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "Trial balance drift",
      "description": "Must be 0 at all times; non-zero = double-entry invariant violation.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "none"
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(rate(ledger_trial_balance_drift_minor[5m]))", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "title": "JVM heap utilisation",
      "type": "gauge",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.85 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [
        { "expr": "ledger:jvm_heap_utilization", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "title": "Kafka consumer lag",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "unit": "short"
        }
      },
      "options": { "legend": { "calcs": ["max"], "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "ledger:consumer_lag_total", "legendFormat": "{{ topic }}", "refId": "A" }
      ]
    },
    {
      "id": 8,
      "title": "5xx error ratio (last 5m)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "unit": "percentunit"
        }
      },
      "options": { "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "ledger:error_ratio_5m", "legendFormat": "5xx ratio", "refId": "A" }
      ]
    },
    {
      "id": 9,
      "title": "Balance read p99 (SLO: ≤ 50ms)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "unit": "s"
        }
      },
      "options": { "legend": { "calcs": ["max"], "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "ledger:balance_read_p99_seconds", "legendFormat": "balance read p99", "refId": "A" }
      ]
    },
    {
      "id": 10,
      "title": "Report p99 (SLO: ≤ 5s)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "unit": "s"
        }
      },
      "options": { "legend": { "calcs": ["max"], "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "ledger:report_p99_seconds", "legendFormat": "report p99", "refId": "A" }
      ]
    },
    {
      "id": 11,
      "title": "JVM memory (heap + non-heap)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "unit": "bytes"
        }
      },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "jvm_memory_used_bytes{service=\"ledger-service\",area=\"heap\"}", "legendFormat": "heap used", "refId": "A" },
        { "expr": "jvm_memory_used_bytes{service=\"ledger-service\",area=\"nonheap\"}", "legendFormat": "non-heap used", "refId": "B" }
      ]
    },
    {
      "id": 12,
      "title": "Request rate by status",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "unit": "reqps"
        }
      },
      "options": { "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{service=\"ledger-service\"}[1m])) by (status)", "legendFormat": "{{ status }}", "refId": "A" }
      ]
    }
  ],
