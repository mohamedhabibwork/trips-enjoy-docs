# Local-development env template for fraud-risk-service.
# Copy to .env (gitignored) and fill in any non-default values.
#
# Database: single shared `trips_enjoy`; fraud-risk-service owns schema `fraud_risk`.

PLATFORM_ENV=dev

# ----- Database (used by both the runtime pool + alembic) -----
FRAUD_RISK_SERVICE_DB_URL=postgresql+asyncpg://postgres@0.0.0.0:5432/trips_enjoy?options=-c%20search_path%3Dfraud_risk,public
FRAUD_RISK_SERVICE_DB_SYNC_URL=postgresql+psycopg2://postgres@0.0.0.0:5432/trips_enjoy?options=-c%20search_path%3Dfraud_risk,public

FRAUD_RISK_SERVICE_DB_USERNAME=postgres
FRAUD_RISK_SERVICE_DB_PASSWORD=

# ----- Redis -----
FRAUD_RISK_SERVICE_REDIS_URL=redis://0.0.0.0:6379

# ----- Kafka (platform cluster) -----
FRAUD_RISK_SERVICE_KAFKA_BOOTSTRAP_SERVERS=http://81.208.166.110:9092

# ----- Keycloak (shared; this service validates JWTs only) -----
FRAUD_RISK_SERVICE_KEYCLOAK_BASE_URL=http://0.0.0.0:8181
FRAUD_RISK_SERVICE_KEYCLOAK_ISSUER_URI=http://0.0.0.0:8181/realms/platform-services
FRAUD_RISK_SERVICE_KEYCLOAK_JWKS_URI=http://0.0.0.0:8181/realms/platform-services/protocol/openid-connect/certs

# ----- Port -----
PORT=8095

# ----- Secrets (Vault path convention) -----
#   kv/<env>/fraud-risk/db/url
# See docs/architecture/SECURITY_ARCHITECTURE.md §Secrets.
