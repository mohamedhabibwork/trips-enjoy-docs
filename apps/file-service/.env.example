# Local-development env template for file-service.
# Copy to .env (gitignored) and fill in any non-default values.
# Profile-driven: PLATFORM_ENV selects stg/prod overrides at deploy time
# (see docs/architecture/CONFIGURATION_ARCHITECTURE.md).

# ----- Profile -----
PLATFORM_ENV=dev

# ----- Database -----
# Single shared DB `trips_enjoy`; this service owns schema `file`.
# search_path=`file,public`, so unqualified table lookups resolve against `file` first.
FILE_SERVICE_DB_URL=postgres://postgres@0.0.0.0:5432/trips_enjoy?sslmode=disable&options=-c%20search_path%3Dfile,public

# ----- Redis -----
FILE_SERVICE_REDIS_ADDR=0.0.0.0:6379
FILE_SERVICE_REDIS_PASSWORD=

# ----- Kafka (platform cluster) -----
FILE_SERVICE_KAFKA_BOOTSTRAP_SERVERS=http://81.208.166.110:9092

# ----- Keycloak (shared; this service validates JWTs only) -----
FILE_SERVICE_KEYCLOAK_BASE_URL=http://0.0.0.0:8181
FILE_SERVICE_KEYCLOAK_ISSUER_URI=http://0.0.0.0:8181/realms/platform-services
FILE_SERVICE_KEYCLOAK_JWKS_URI=http://0.0.0.0:8181/realms/platform-services/protocol/openid-connect/certs

# ----- Object-storage drivers (see docs/services/file-service/ERD.md) -----
# Each driver is gated by an _ENABLED flag. Default off (dev uses local_fs).
# Enable in stg/prod by setting FILE_SERVICE_<KIND>_ENABLED=true and providing credentials.

# --- AWS S3 / S3-compatible (MinIO / R2 / RGW) ---
FILE_SERVICE_S3_ENABLED=false
FILE_SERVICE_S3_REGION=us-east-1
FILE_SERVICE_S3_ENDPOINT=                       # leave empty for AWS native; set for MinIO/R2/RGW
FILE_SERVICE_S3_BUCKET=trips-enjoy-file-dev
FILE_SERVICE_S3_ACCESS_KEY=
FILE_SERVICE_S3_SECRET_KEY=
FILE_SERVICE_S3_PATH_STYLE=false                # true for MinIO/R2/RGW
FILE_SERVICE_S3_KMS_KEY_ID=

# --- Azure Blob Storage ---
FILE_SERVICE_AZURE_BLOB_ENABLED=false
FILE_SERVICE_AZURE_BLOB_ACCOUNT=
FILE_SERVICE_AZURE_BLOB_ACCOUNT_KEY=
FILE_SERVICE_AZURE_BLOB_CONTAINER=trips-enjoy-file-dev
FILE_SERVICE_AZURE_BLOB_ENDPOINT=               # leave empty for default

# --- Oracle Object Storage (native REST + optional S3-compatible endpoint) ---
FILE_SERVICE_OCI_ENABLED=false
FILE_SERVICE_OCI_NAMESPACE=
FILE_SERVICE_OCI_REGION=us-ashburn-1
FILE_SERVICE_OCI_BUCKET=
FILE_SERVICE_OCI_COMPARTMENT_ID=
FILE_SERVICE_OCI_S3_COMPATIBLE=true
FILE_SERVICE_OCI_S3_ENDPOINT=
FILE_SERVICE_OCI_ACCESS_KEY=
FILE_SERVICE_OCI_SECRET_KEY=

# --- Google Cloud Storage ---
FILE_SERVICE_GCS_ENABLED=false
FILE_SERVICE_GCS_BUCKET=
FILE_SERVICE_GCS_SERVICE_ACCOUNT_EMAIL=
# PEM-encoded RSA private key for SignedURL. In production, mount this
# from a secret manager (Vault / k8s external-secrets) — never commit it.
FILE_SERVICE_GCS_PRIVATE_KEY_PEM=

# ----- Secrets (Vault path convention) -----
#   stg:  vault kv get secret/file-service/staging/db/url
#   prod: vault kv get secret/file-service/prod/db/url
# See docs/architecture/SECURITY_ARCHITECTURE.md §Secrets.

# ----- Server ports (per docs/services/file-service/INTEGRATION.md) -----
# Public + admin endpoints share the :8080 mux per INTEGRATION.md; TECH.md
# §10.4 admin mux is exposed on :8081 for ops tooling (/admin/v1/*).
FILE_SERVICE_PUBLIC_PORT=8084
FILE_SERVICE_ADMIN_PORT=8081

# ----- Database (credentialed; defaults match the local Homebrew/Herd install) -----
FILE_SERVICE_DB_USERNAME=postgres
FILE_SERVICE_DB_PASSWORD=

# ----- Redis (split host/port for parity with other Go services) -----
FILE_SERVICE_REDIS_HOST=0.0.0.0
FILE_SERVICE_REDIS_PORT=6379

# ----- local_fs driver root (afero-backed; required when local_fs is enabled) -----
FILE_SERVICE_LOCAL_FS_ROOT=/tmp/trips-enjoy-file-dev

# ----- HMAC secret for admin retention/pinning/migration overrides -----
# Per-driver signing keys live in Vault. This is the service-wide HMAC secret.
FILE_SERVICE_HMAC_SECRET=local-dev-hmac-secret-change-me

# ----- OpenTelemetry -----
# When unset, OTel init is a no-op (logs only).
FILE_SERVICE_OTEL_EXPORTER_OTLP_ENDPOINT=
FILE_SERVICE_OTEL_SERVICE_NAME=file-service

# ----- Kafka topics (per docs/services/file-service/INTEGRATION.md §3) -----
FILE_SERVICE_KAFKA_TOPIC_FILE_UPLOADED=file.file.uploaded
FILE_SERVICE_KAFKA_TOPIC_FILE_SCANNED=file.file.scanned
FILE_SERVICE_KAFKA_TOPIC_FILE_DELETED=file.file.deleted
FILE_SERVICE_KAFKA_TOPIC_FILE_MIGRATED=file.file.migrated
