# Local-development env template for geolocation-service.
# Copy to .env (gitignored) and fill in any non-default values.
# Profile-driven: PLATFORM_ENV selects stg/prod overrides at deploy time
# (see docs/architecture/CONFIGURATION_ARCHITECTURE.md).

# ----- Profile -----
PLATFORM_ENV=dev

# ----- Database -----
# Single shared DB `trips_enjoy`; this service owns schema `geolocation`.
# search_path=`geolocation,public`, so unqualified table lookups resolve against `geolocation` first.
GEOLOCATION_SERVICE_DB_URL=postgres://postgres@0.0.0.0:5432/trips_enjoy?sslmode=disable&options=-c%20search_path%3Dgeolocation,public

# ----- Redis -----
# Hot cache for geocodes / ETA / routes + chain plan cache.
GEOLOCATION_SERVICE_REDIS_HOST=0.0.0.0
GEOLOCATION_SERVICE_REDIS_PORT=6379
GEOLOCATION_SERVICE_REDIS_PASSWORD=

# ----- Kafka (platform cluster) -----
GEOLOCATION_SERVICE_KAFKA_BOOTSTRAP_SERVERS=http://81.208.166.110:9092

# ----- Keycloak (shared; this service validates JWTs only) -----
GEOLOCATION_SERVICE_KEYCLOAK_BASE_URL=http://0.0.0.0:8181
GEOLOCATION_SERVICE_KEYCLOAK_ISSUER_URI=http://0.0.0.0:8181/realms/platform-services
GEOLOCATION_SERVICE_KEYCLOAK_JWKS_URI=http://0.0.0.0:8181/realms/platform-services/protocol/openid-connect/certs

# ----- Geocoding vendor (Google Maps, HERE, etc.; per docs/services/geolocation-service/TECH.md) -----
GEOLOCATION_SERVICE_GOOGLEMAPS_API_KEY=
GEOLOCATION_SERVICE_HERE_API_KEY=

# ----- HMAC secret for admin endpoints (per INTEGRATION.md §5.4) -----
GEOLOCATION_SERVICE_HMAC_SECRET=local-dev-hmac-secret-change-me

# ----- OpenTelemetry -----
# When unset, OTel init is a no-op (logs only).
GEOLOCATION_SERVICE_OTEL_EXPORTER_OTLP_ENDPOINT=
GEOLOCATION_SERVICE_OTEL_SERVICE_NAME=geolocation-service

# ----- Server ports (per docs/services/geolocation-service/TECH.md §10.5) -----
# Public + admin endpoints share the :8085 mux per INTEGRATION.md; TECH.md
# §10.4 admin mux is exposed on :8086 for ops tooling (/admin/v1/*).
GEOLOCATION_SERVICE_PUBLIC_PORT=8085
GEOLOCATION_SERVICE_ADMIN_PORT=8086

# ----- Database (credentialed; defaults match the local Homebrew/Herd install) -----
GEOLOCATION_SERVICE_DB_USERNAME=postgres
GEOLOCATION_SERVICE_DB_PASSWORD=

# ----- PostGIS extension must exist in the trips_enjoy database (one-time, by DBA) -----
GEOLOCATION_SERVICE_POSTGIS_ENABLED=true

# ----- Cache TTLs (per docs/services/geolocation-service/SRS.md §12.4) -----
GEOLOCATION_SERVICE_GEOCODE_TTL_SECONDS=86400
GEOLOCATION_SERVICE_ETA_TTL_SECONDS=60
GEOLOCATION_SERVICE_ROUTE_TTL_SECONDS=300
GEOLOCATION_SERVICE_PROVIDER_CHAIN_CACHE_TTL_SECONDS=60

# ----- Kafka topics (per docs/services/geolocation-service/INTEGRATION.md §3) -----
GEOLOCATION_SERVICE_KAFKA_TOPIC_GEOCODED=geolocation.geocoded
GEOLOCATION_SERVICE_KAFKA_TOPIC_ETA_COMPUTED=geolocation.eta.computed
GEOLOCATION_SERVICE_KAFKA_TOPIC_CACHE_INVALIDATED=geolocation.cache.invalidated
GEOLOCATION_SERVICE_KAFKA_TOPIC_PROVIDER_CHAIN=geolocation.provider_chain.changed
GEOLOCATION_SERVICE_KAFKA_TOPIC_PROVIDER_HEALTH=geolocation.provider_health

# ----- Secrets (Vault path convention) -----
#   stg:  vault kv get secret/geolocation-service/staging/db/url
#   prod: vault kv get secret/geolocation-service/prod/db/url
# Per-provider vendor keys: vault kv get kv/<env>/geolocation/<vendor_id>
# See docs/architecture/SECURITY_ARCHITECTURE.md §Secrets.