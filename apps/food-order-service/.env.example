# Local-development env template for food-order-service.
# Copy to .env (gitignored) and fill in any non-default values.
# Profile-driven: SPRING_PROFILES_ACTIVE selects which application-{profile}.yml
# to activate (dev|stg|prod). See docs/architecture/CONFIGURATION_ARCHITECTURE.md.

SPRING_PROFILES_ACTIVE=dev

# ----- Database -----
# Single shared DB `trips_enjoy`; this service owns schema `food_order` (Flyway creates it on boot).
FOOD_ORDER_SERVICE_DB_URL=jdbc:postgresql://0.0.0.0:5432/trips_enjoy?currentSchema=food_order
FOOD_ORDER_SERVICE_DB_USERNAME=postgres
FOOD_ORDER_SERVICE_DB_PASSWORD=

# ----- Redis -----
FOOD_ORDER_SERVICE_REDIS_HOST=0.0.0.0
FOOD_ORDER_SERVICE_REDIS_PORT=6379
FOOD_ORDER_SERVICE_REDIS_PASSWORD=

# ----- Kafka -----
# Platform Kafka cluster (inherited). Override per-env via Vault at deploy time.
FOOD_ORDER_SERVICE_KAFKA_BOOTSTRAP_SERVERS=http://81.208.166.110:9092

# ----- Keycloak -----
# Platform Keycloak (inherited). All values are placeholders; real values come
# from a per-service .env (gitignored) in local dev, or Vault in stg/prod.
FOOD_ORDER_SERVICE_KEYCLOAK_BASE_URL=http://0.0.0.0:8181
FOOD_ORDER_SERVICE_KEYCLOAK_ISSUER_URI=http://0.0.0.0:8181/realms/platform-services
FOOD_ORDER_SERVICE_KEYCLOAK_JWKS_URI=http://0.0.0.0:8181/realms/platform-services/protocol/openid-connect/certs
FOOD_ORDER_SERVICE_KEYCLOAK_ADMIN_REALM=master
FOOD_ORDER_SERVICE_KEYCLOAK_ADMIN_CLIENT_ID=
FOOD_ORDER_SERVICE_KEYCLOAK_ADMIN_CLIENT_SECRET=
FOOD_ORDER_SERVICE_KEYCLOAK_ADMIN_USERNAME=
FOOD_ORDER_SERVICE_KEYCLOAK_ADMIN_PASSWORD=
