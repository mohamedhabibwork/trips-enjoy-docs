# api-gateway — local configuration
#
# Convention: every variable is API_GATEWAY_* per the platform's
# <SVC>_* baseline (docs/shared/PLATFORM_BASELINE.md §11).
# Secrets (Keycloak admin secret, Redis password, Kafka SASL)
# MUST come from Vault in stg/prod — never from this file.

# ----- Public mux -----
# API_GATEWAY_PORT defaults to "8080" when unset.
# API_GATEWAY_CORS_ALLOWED_ORIGINS is a comma-separated allowlist.
API_GATEWAY_PORT=8080
API_GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
API_GATEWAY_BODY_MAX_BYTES=1048576

# ----- Admin mux (0.0.0.0-only) -----
API_GATEWAY_ADMIN_PORT=8081
API_GATEWAY_ADMIN_BIND=0.0.0.0
# Static bearer used by operator scripts; in stg/prod the linkerd
# sidecar's mTLS cert is the primary credential.
API_GATEWAY_ADMIN_TOKEN=

# ----- Keycloak / JWT -----
# Comma-separated list of realm issuer URLs. The gateway builds one
# oidc verifier per issuer.
API_GATEWAY_KEYCLOAK_ISSUER_URLS=https://keycloak.cloud.habib.cloud/realms/platform-customer,https://keycloak.cloud.habib.cloud/realms/platform-driver,https://keycloak.cloud.habib.cloud/realms/platform-courier,https://keycloak.cloud.habib.cloud/realms/platform-staff,https://keycloak.cloud.habib.cloud/realms/platform-internal,https://keycloak.cloud.habib.cloud/realms/platform-services
API_GATEWAY_KEYCLOAK_JWKS_REFRESH=5m
API_GATEWAY_KEYCLOAK_CACHE_TTL=5m

# ----- Redis (shared cluster) -----
# Local-dev default points at host loopback (matches config.go's
# defaultRedisAddr). In the k8s cluster override this to
# `redis.trips-enjoy.svc.cluster.local:6379` (or the in-cluster
# shortname `redis:6379`) via Vault or the per-env ConfigMap.
API_GATEWAY_REDIS_ADDR=127.0.0.1:6379
API_GATEWAY_REDIS_PASSWORD=
API_GATEWAY_REDIS_DB=0
API_GATEWAY_REDIS_TIMEOUT=100ms

# ----- Kafka (shared cluster) -----
# Default points at the shared dev/stg cluster. Override per-env via Vault.
API_GATEWAY_KAFKA_BOOTSTRAP_SERVERS=http://81.208.166.110:9092
API_GATEWAY_KAFKA_AUDIT_TOPIC=audit.api.request
API_GATEWAY_KAFKA_AUDIT_DLQ_TOPIC=audit.api.request.dlq
API_GATEWAY_KAFKA_IDENTITY_TOPIC=identity.events
API_GATEWAY_KAFKA_CONFIGURATION_TOPIC=configuration.events
API_GATEWAY_KAFKA_CONSUMER_GROUP=api-gateway
API_GATEWAY_KAFKA_REQUEST_TIMEOUT=5s

# ----- Upstream isolation (SERVICE_ISOLATION.md §4) -----
API_GATEWAY_UPSTREAM_TIMEOUT=30s
API_GATEWAY_BULKHEAD_SIZE=1024
API_GATEWAY_CIRCUIT_THRESHOLD=5
API_GATEWAY_CIRCUIT_COOLDOWN=30s

# ----- Aggregated downstream-health endpoint (/healthz/downstream) -----
# Per-service probe budget for the public aggregator endpoint.
# Each probe is bounded by this timeout; total sweep finishes in
# ceil(N/parallelism) * timeout + RTT.
API_GATEWAY_DOWNSTREAM_PROBE_TIMEOUT=2s
# Worker pool size for parallel probe fan-out. Clamped to [1, 32]
# at request time via ?parallelism=.
API_GATEWAY_DOWNSTREAM_PROBE_PARALLEL=8

# ----- Audit sampling (SRS §22 / WORKFLOWS §1) -----
API_GATEWAY_AUDIT_SAMPLE_RATIO=1.0

# ----- OpenTelemetry -----
API_GATEWAY_OTEL_SERVICE_NAME=api-gateway
API_GATEWAY_OTEL_SERVICE_VERSION=0.1.0
API_GATEWAY_OTEL_ENVIRONMENT=dev
API_GATEWAY_OTEL_REGION=local
# Empty -> stdout exporter (good for local). Set to OTLP endpoint in
# stg/prod (e.g. otel-collector.observability.svc:4317).
API_GATEWAY_OTEL_EXPORTER_OTLP_ENDPOINT=
API_GATEWAY_OTEL_SAMPLE_RATIO=1.0

# ----- Per-upstream overrides -----
# Pattern: <SERVICE>_UPSTREAM_URL, e.g. PAYMENT_SERVICE_UPSTREAM_URL.
# Defaults fall back to http://<service>:8080.
PAYMENT_SERVICE_UPSTREAM_URL=http://payment-service:8080
IDENTITY_SERVICE_UPSTREAM_URL=http://identity-service:8080
CONFIGURATION_SERVICE_UPSTREAM_URL=http://configuration-service:8080
TRIP_SERVICE_UPSTREAM_URL=http://trip-service:8080
CUSTOMER_SERVICE_UPSTREAM_URL=http://customer-service:8080
ADMIN_SERVICE_UPSTREAM_URL=http://admin-service:8080
AUDIT_SERVICE_UPSTREAM_URL=http://audit-service:8080
DRIVER_SERVICE_UPSTREAM_URL=http://driver-service:8080
COURIER_SERVICE_UPSTREAM_URL=http://courier-service:8080
RESTAURANT_SERVICE_UPSTREAM_URL=http://restaurant-service:8080
FOOD_ORDER_SERVICE_UPSTREAM_URL=http://food-order-service:8080
LEDGER_SERVICE_UPSTREAM_URL=http://ledger-service:8080
PRICING_SERVICE_UPSTREAM_URL=http://pricing-service:8080
REPORTING_SERVICE_UPSTREAM_URL=http://reporting-service:8080
NOTIFICATION_SERVICE_UPSTREAM_URL=http://notification-service:8080
FRAUD_RISK_SERVICE_UPSTREAM_URL=http://fraud-risk-service:8080
SEARCH_SERVICE_UPSTREAM_URL=http://search-service:8080
GEOLOCATION_SERVICE_UPSTREAM_URL=http://geolocation-service:8080
FILE_SERVICE_UPSTREAM_URL=http://file-service:8080
CHAT_SERVICE_UPSTREAM_URL=http://chat-service:8080
