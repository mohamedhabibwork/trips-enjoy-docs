# Local-development env template for identity-service.
# Copy to .env (gitignored) and fill in any non-default values.
# Profile-driven: SPRING_PROFILES_ACTIVE selects which application-{profile}.yml
# to activate (dev|stg|prod). See docs/architecture/CONFIGURATION_ARCHITECTURE.md.

# ----- Profile -----
SPRING_PROFILES_ACTIVE=dev

# ----- Database -----
# Per docs/architecture/DATABASE_ARCHITECTURE.md, identity is one of 4 services
# flagged for physical-cluster isolation in stg/prod. Locally it shares the
# `trips_enjoy` database with every other service and owns schema `identity`.
IDENTITY_DB_URL=jdbc:postgresql://0.0.0.0:5432/trips_enjoy?currentSchema=identity
IDENTITY_DB_USERNAME=postgres
IDENTITY_DB_PASSWORD=

# ----- Redis (token cache, rate limiter) -----
IDENTITY_REDIS_HOST=0.0.0.0
IDENTITY_REDIS_PORT=6379
IDENTITY_REDIS_PASSWORD=

# ----- Kafka (outbox publish target) -----
# Platform Kafka cluster (shared across services).
IDENTITY_KAFKA_BOOTSTRAP_SERVERS=http://81.208.166.110:9092

# Public identity-service URL used by Swagger/OpenAPI. Swagger must call
# identity-service, never the Keycloak host directly.
IDENTITY_PUBLIC_URL=http://localhost:8082

# ----- Request-signing secret (HMAC for `platform.super_admin` grants) -----
# Required at runtime. Generate a fresh 32-byte secret per environment and
# distribute via Vault/ConfigMap. Never commit a literal value. The HMAC
# gate is used by the super-admin break-glass path; a known secret would
# let an authenticated admin forge a valid X-Signature.
IDENTITY_REQUEST_SIGNING_SECRET=

# ----- Keycloak -----
# Platform Keycloak (shared). All values are placeholders; real values come from
# a per-service .env (gitignored) in local dev, or Vault in stg/prod.
# Identity-service is the only service with admin-client access; the others
# validate JWTs only (issuer/jwks).
IDENTITY_KEYCLOAK_BASE_URL=http://0.0.0.0:8181
IDENTITY_KEYCLOAK_ISSUER_URI=http://0.0.0.0:8181/realms/platform-services
IDENTITY_KEYCLOAK_JWKS_URI=http://0.0.0.0:8181/realms/platform-services/protocol/openid-connect/certs
IDENTITY_KEYCLOAK_ADMIN_REALM=master
IDENTITY_KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
IDENTITY_KEYCLOAK_ADMIN_CLIENT_SECRET=Yztlv8RpyyAKOxzOMzDOtoS2YkKfkG5r
IDENTITY_KEYCLOAK_ADMIN_USERNAME=admin@inovoria.com
IDENTITY_KEYCLOAK_ADMIN_PASSWORD=H@bib1998
IDENTITY_KEYCLOAK_SEED_ENABLED=true
IDENTITY_KEYCLOAK_SUPER_ADMIN_USERNAME="admin@trips-enjoy.com"
IDENTITY_KEYCLOAK_SUPER_ADMIN_PASSWORD="H@bib1998"
# Dev users created by the seeder (customer@trips-enjoy.com,
# driver@trips-enjoy.com, courier@trips-enjoy.com,
# restaurant-staff@trips-enjoy.com, merchant-staff@trips-enjoy.com,
# support@trips-enjoy.com, finance@trips-enjoy.com, plus the
# super-admin user above) get this password. Override for any
# non-local environment.
IDENTITY_KEYCLOAK_SEED_DEFAULT_PASSWORD=H@bib1998
IDENTITY_KEYCLOAK_GLOBAL_ADMIN_ENABLED=true

# ----- Keycloak topology -----
# `single-realm` (default) puts every client, role, mapper, and user in one
# realm (`dev-realm-name`, default `platform-dev`). `multi-realm` uses the
# documented 6-realm split (stg/prod default).
IDENTITY_KEYCLOAK_TOPOLOGY=single-realm
# Realm name when topology=single-realm. Also the default-realm surfaced in
# Swagger UI (overridden by IDENTITY_KEYCLOAK_DEFAULT_REALM in OpenApiConfig).
IDENTITY_KEYCLOAK_DEV_REALM_NAME=platform-services
# Optional overrides (default to dev-realm-name in single-realm mode, or
# to platform-services / platform-internal in multi-realm mode). Useful
# for testing a tenant-isolation failure or staging a migration.
IDENTITY_KEYCLOAK_SERVICES_REALM_NAME=platform-services
IDENTITY_KEYCLOAK_ADMIN_REALM_NAME=master

# ----- Outbox relay -----
IDENTITY_OUTBOX_PUBLISH_INTERVAL_MS=1000

# ----- Dev-mode Keycloak (operational note) -----
# The seeder takes 3-5 minutes to install 130 realm roles + 37 clients + 63
# protocol mappers + 8 users via REST round-trips. Keycloak 24 dev-mode issues
# 60-second access tokens with no refresh-token support, which would cause
# the seeder to hang at the 63rd protocol mapper (jstack confirms: stuck in
# ProtocolMappersResource.createMapper waiting for an HTTP response).
#
# The seeder retries once on HTTP 401 invalid_token (see KeycloakSeeder.kt
# `withFreshClient` + `isTokenExpired`), so the run completes even with
# the 60-second TTL — but to avoid re-auth noise, run the local Keycloak
# with a 30-minute access-token TTL:
#
#   docker run --rm -d --name kc -p 8181:8080 \
#     -e KEYCLOAK_ADMIN=admin -e KEYCLOAK_ADMIN_PASSWORD=admin \
#     -e KC_SPI_ADMIN_AUTH_ACCESS_TOKEN_LIFESPAN=1800 \
#     quay.io/keycloak/keycloak:24.0 start-dev
#
# The seeder is auto-resilient in either case (retries on expiry), but the
# longer TTL keeps the log clean — one "Keycloak admin token expired;
# reopening client and retrying" INFO line per expiry instead of dozens.

# ----- Secrets (Vault path convention) -----
#   stg:  vault kv get secret/identity-service/staging/db/url
#   prod: vault kv get secret/identity-service/prod/db/url
# See docs/architecture/SECURITY_ARCHITECTURE.md §Secrets.
