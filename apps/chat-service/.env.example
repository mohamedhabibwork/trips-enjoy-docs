# Local-development env template for chat-service (stateless; no DB).
# Copy to .env (gitignored) and fill in any non-default values.

PLATFORM_ENV=dev
PORT=8104

# ----- Redis (WebSocket fanout) -----
CHAT_SERVICE_REDIS_ADDR=0.0.0.0:6379
CHAT_SERVICE_REDIS_PASSWORD=

# ----- Kafka (platform cluster) -----
CHAT_SERVICE_KAFKA_BOOTSTRAP_SERVERS=http://81.208.166.110:9092

# ----- Keycloak (JWKS-only; no admin client) -----
CHAT_SERVICE_KEYCLOAK_BASE_URL=http://0.0.0.0:8181
CHAT_SERVICE_KEYCLOAK_ISSUER_URI=http://0.0.0.0:8181/realms/platform-services
CHAT_SERVICE_KEYCLOAK_JWKS_URI=http://0.0.0.0:8181/realms/platform-services/protocol/openid-connect/certs
